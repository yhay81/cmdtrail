{
  "schema_version": "benchmark.thresholds.v1",
  "benchmark_schema_version": "cmdtrail.benchmark.v1",
  "runner": {
    "os": "Linux",
    "arch": "x86_64",
    "image": "ubuntu24"
  },
  "warmup_count": 1,
  "sample_count": 20,
  "metrics": [
    {
      "id": "portable_snapshot_10k_wall_p95",
      "description": "Complete portable pre/post snapshot of the 10,000-file fixture",
      "source": {
        "kind": "measurement_process",
        "measurement_id": "portable_snapshot_10k_files",
        "field": "wall_seconds"
      },
      "statistic": "p95",
      "maximum": 2.0,
      "unit": "seconds",
      "regression": {
        "max_ratio": 1.5,
        "absolute_tolerance": 0.1
      }
    },
    {
      "id": "bounded_peak_rss_max",
      "description": "Maximum peak resident memory across the 1k, 10k, and 100k fixtures",
      "source": {
        "kind": "derived",
        "field": "max_peak_rss_mib"
      },
      "statistic": "max",
      "maximum": 256.0,
      "unit": "MiB",
      "regression": {
        "max_ratio": 1.5,
        "absolute_tolerance": 16.0
      }
    }
  ]
}
